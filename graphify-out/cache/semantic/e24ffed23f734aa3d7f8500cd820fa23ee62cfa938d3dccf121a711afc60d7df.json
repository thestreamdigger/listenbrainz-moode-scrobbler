{"nodes": [{"id": "readme", "label": "README.md", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_listenbrainz", "label": "ListenBrainz", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_moode_audio_player", "label": "moOde Audio Player", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_currentsong_txt", "label": "currentsong.txt", "file_type": "concept", "rationale": "moOde-written metadata file at /var/local/www/currentsong.txt; the scrobbler's sole input. Must be enabled in moOde MPD options or the scrobbler sees nothing.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_canonical_scrobble_rule", "label": "Canonical Scrobble Rule", "file_type": "rationale", "rationale": "min(duration * 50%, 240s) with floor at min_play_time, per ListenBrainz/MetaBrainz recommendations. Falls back to min_play_time when duration is absent from currentsong.txt (streams filtered via patterns).", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_min_play_time", "label": "min_play_time Floor", "file_type": "rationale", "rationale": "Configurable floor (default 30s) under the canonical rule; also the always-used fallback delay for renderer sessions that carry no duration.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_offline_cache", "label": "Offline Cache", "file_type": "rationale", "rationale": "Survive network outages: individual submission for <3 pending, batch up to 10 after recovery, 60s connection re-check, atomic writes (fsync + rename), .corrupt.<timestamp> backup on parse errors.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_pattern_filters", "label": "Pattern Filters", "file_type": "rationale", "rationale": "Skip scrobbles matching artist/album/title patterns (radio streams, unknown artists); case sensitivity configurable.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_env_token_storage", "label": "Token Storage (.env)", "file_type": "rationale", "rationale": "ListenBrainz token lives in .env (mode 600, gitignored), never in settings.json; redacted in all log output.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_lbms_service", "label": "lbms.service Systemd Unit", "file_type": "concept", "rationale": "Installed to /etc/systemd/system/lbms.service by install.sh; enabled for boot autostart; runs as $SUDO_USER (fallback pi); waits for network-online.target.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_listening_now", "label": "Listening Now Status", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_renderer_sources", "label": "AirPlay / Spotify Connect Renderers", "file_type": "concept", "rationale": "moOde 10.2+ writes renderer artist/album/title with no state or duration, so pause is not detectable and the scrobble delay is always the min_play_time fallback. Bluetooth, Squeezelite, RoonBridge, Deezer are out of scope (marker only, no metadata).", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dry_run_mode", "label": "--dry-run Mode", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_repeat_one_limitation", "label": "Repeat-1 Single Listen Limitation", "file_type": "rationale", "rationale": "Repeating the same track without a state transition produces a single listen: track identity is title/artist/album and MPD does not signal the boundary in currentsong.txt.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme", "target": "readme_listenbrainz", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_moode_audio_player", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_currentsong_txt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_canonical_scrobble_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_offline_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_pattern_filters", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0